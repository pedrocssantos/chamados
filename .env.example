# ==============================================================================
# VARIÁVEIS DE AMBIENTE - SISTEMA DE CHAMADOS MAXIMO ALDANA
# Configure estas variáveis nas configurações do seu projeto na VERCEL:
# Project Settings -> Environment Variables
# ==============================================================================

# 1. SUPABASE (Banco de Dados PostgreSQL & Realtime)
# Obtenha em: Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 2. RESEND (Disparo Transacional de E-mails)
# Obtenha em: Resend Dashboard -> API Keys
RESEND_API_KEY=re_123456789_abcdefg...

# Remetente do e-mail (use onboarding@resend.dev para testes ou seu domínio ti@maximoaldana.com.br após validar o domínio)
NOTIFICATION_EMAIL_FROM="TI Maximo Aldana <onboarding@resend.dev>"

# E-mail de destino padrão para receber novos chamados e alertas
NOTIFICATION_EMAIL_TO="pedro.santos@maximoaldana.com.br"
